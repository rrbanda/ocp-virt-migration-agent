# --- LLM Provider (OpenAI-compatible) ---
# OPENAI_API_BASE=https://your-llm-endpoint/v1
# OPENAI_API_KEY=not-needed
# ADK_MODEL=openai/gemini/models/gemini-2.5-flash

# Uncomment for Google AI Studio (instead of OpenAI-compatible):
# GOOGLE_API_KEY=your-key-here

# --- Agent Configuration ---
# AGENT_MODE=pipeline
# AGENT_NAME=migration_coordinator
# AGENT_DESC=VMware-to-OCP Virt migration coordinator
# SKILLS_DIR=/skills
# MAX_LLM_CALLS=200

# --- Context Compaction ---
# COMPACTION_TOKEN_THRESHOLD=8000
# COMPACTION_EVENT_RETENTION=5

# --- Migration Monitoring ---
# MAX_MONITOR_POLLS=30

# --- Network Mapping ---
# DEFAULT_NETWORK_DESTINATION=pod

# --- MTV / OCP Virt Cluster (empty = in-cluster auth) ---
# MTV_API_URL=
# MTV_API_TOKEN=
# MTV_API_CA=
# VIRT_API_URL=
# VIRT_API_TOKEN=
# VIRT_API_CA=
# MTV_INVENTORY_URL=
# MTV_INVENTORY_TOKEN=
# MTV_INVENTORY_ROUTE_NAME=forklift-inventory
# DEFAULT_MTV_NAMESPACE=mtv-user1
# DEFAULT_VIRT_NAMESPACE=vmimported-user1
# MTV_OPERATOR_NAMESPACE=openshift-mtv
# TARGET_STORAGE_CLASS=ocs-external-storagecluster-ceph-rbd

# --- TLS verification for inventory HTTP (set to CA path, "true", or "false") ---
# OCP_CA_BUNDLE=true

# --- AAP (Ansible Automation Platform) ---
# AAP_URL=
# AAP_TOKEN=
# AAP_API_PREFIX=/api/controller/v2
# AAP_CA_BUNDLE=
# PRE_MIGRATION_TEMPLATE_ID=
# POST_MIGRATION_TEMPLATE_ID=
# AAP_MAX_OUTPUT_BYTES=524288

# --- Safety Guardrail ---
MIGRATION_DRY_RUN=true

# --- API Server ---
# API_USER_ID=api_user
# API_REQUEST_TIMEOUT=300

# --- Behavioral Tests ---
# MIGRATION_AGENT_URL=http://localhost:8080

# --- MLflow Tracing (optional -- install with: pip install gadk-rhoai-agent[tracing]) ---
# MLFLOW_TRACKING_URI=https://mlflow.redhat-ods-applications.svc.cluster.local:8443
# MLFLOW_EXPERIMENT_NAME=migration-agent
# MLFLOW_TRACKING_INSECURE_TLS=false
# MLFLOW_HEALTH_CHECK_TIMEOUT=5
