# OCP Virt Migration Agent
#
# Build:
#   podman build --platform linux/amd64 -f deploy/Dockerfile.agent -t ghcr.io/rrbanda/ocp-virt-migration-agent:latest .
#
# Run:
#   docker run -p 8080:8080 -e BASE_URL=http://localhost:8321/v1 -e MODEL_ID=llama3.1:8b ghcr.io/rrbanda/ocp-virt-migration-agent:latest

FROM registry.access.redhat.com/ubi9/python-312@sha256:e95978812895b9abb2bdc109b501078da2a47c8dbb9fa23758af40ed50ab6023
WORKDIR /opt/app-root/src

USER 0

# uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv@sha256:fc93e9ecd7218e9ec8fba117af89348eef8fd2463c50c13347478769aaedd0ce /uv /usr/local/bin/uv

# Install dependencies (layer cached separately from app code)
COPY pyproject.toml .
COPY app/ ./app/
RUN uv pip install --python /opt/app-root/bin/python3 --no-cache ".[tracing]"

# Copy skills to /skills (can be overridden by ConfigMap mount)
RUN mkdir -p /skills && chown 1001:0 /skills
COPY app/skills/ /skills/

RUN chown -R 1001:0 /opt/app-root/src && chmod -R g=u /opt/app-root/src

USER 1001

EXPOSE 8080

ENV PORT=8080 \
    SKILLS_DIR=/skills \
    PYTHONPATH=/opt/app-root/src \
    PATH="/opt/app-root/bin:${PATH}"

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:${PORT}/health')" || exit 1

CMD ["sh", "-c", "uvicorn app.api:fastapi_app --host 0.0.0.0 --port ${PORT}"]
