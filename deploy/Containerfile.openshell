# OCP Virt Migration Agent for NVIDIA OpenShell sandbox
#
# BYOC (Bring Your Own Container) image following the OpenShell pattern:
# https://github.com/NVIDIA/OpenShell/tree/main/examples/bring-your-own-container
#
# Build:
#   podman build --platform linux/amd64 -f deploy/Containerfile.openshell \
#     -t ghcr.io/rrbanda/ocp-virt-migration-agent-sandbox:latest .
#
# Run (OpenShell replaces CMD -- pass the start command after --):
#   openshell sandbox create --name migration-agent \
#     --from ghcr.io/rrbanda/ocp-virt-migration-agent-sandbox:latest \
#     --forward 8080 \
#     -e ADK_MODEL=openai/meta-llama/Llama-3.1-70B-Instruct \
#     -e OPENAI_API_BASE=http://vllm-svc.my-ns.svc.cluster.local:8000/v1 \
#     -e OPENAI_API_KEY=not-needed \
#     -- uvicorn app.api:fastapi_app --host 0.0.0.0 --port 8080

FROM registry.access.redhat.com/ubi9/python-312@sha256:e95978812895b9abb2bdc109b501078da2a47c8dbb9fa23758af40ed50ab6023

USER 0

# iproute: required by OpenShell for network namespace management
# nftables: optional, enables bypass detection (log + reject for direct connections)
RUN dnf install -y --nodocs iproute nftables && dnf clean all && rm -rf /var/cache/dnf

# uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv@sha256:fc93e9ecd7218e9ec8fba117af89348eef8fd2463c50c13347478769aaedd0ce /uv /usr/local/bin/uv

# Application directory (OpenShell convention: /sandbox)
RUN install -d -o 1001 -g 0 -m 775 /sandbox
WORKDIR /sandbox

# Install Python dependencies
COPY --chown=1001:0 pyproject.toml .
COPY --chown=1001:0 app/ ./app/
RUN uv pip install --python /opt/app-root/bin/python3 --no-cache ".[tracing]"

# Skills (baked in; can be overridden by ConfigMap in standard deployment)
RUN mkdir -p /skills && chown 1001:0 /skills
COPY --chown=1001:0 app/skills/ /skills/

RUN chown -R 1001:0 /sandbox

USER 1001

ENV PORT=8080 \
    SKILLS_DIR=/skills \
    AGENT_MODE=pipeline \
    PYTHONPATH=/sandbox \
    PATH="/opt/app-root/bin:${PATH}"

EXPOSE 8080

# OpenShell's sandbox supervisor replaces CMD at runtime.
# Pass the start command explicitly after -- on the CLI.
CMD ["uvicorn", "app.api:fastapi_app", "--host", "0.0.0.0", "--port", "8080"]
